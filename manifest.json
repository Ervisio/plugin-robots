{
  "id": "robots",
  "name": "Browser Robots",
  "description": "Open a real Chromium browser inside Ervisio, automate interactions, record workflows and replay them with Playwright.",
  "author": "Ervisio",
  "version": "0.1.0",
  "minCore": "0.5.0",
  "platforms": ["linux"],
  "entry": "index.js",
  "icon": "globe",
  "color": "term",
  "capabilities": {
    "http": [{
      "name": "robots",
      "socket": "/run/ervisio-browser-robots/control.sock",
      "admin": true,
      "headers": ["Content-Type"],
      "maxBody": 131072,
      "timeoutSec": 60,
      "rules": [
        {"methods": ["GET"], "path": "/v1/health"},
        {"methods": ["GET", "POST"], "path": "/v1/sessions"},
        {"methods": ["DELETE"], "path": "/v1/sessions/[a-f0-9]{14}"},
        {"methods": ["GET"], "path": "/v1/sessions/[a-f0-9]{14}/frame"},
        {"methods": ["POST"], "path": "/v1/sessions/[a-f0-9]{14}/(navigate|action|record)"},
        {"methods": ["GET"], "path": "/v1/workflows"},
        {"methods": ["GET", "DELETE"], "path": "/v1/workflows/[a-f0-9]{14}"},
        {"methods": ["POST"], "path": "/v1/workflows/[a-f0-9]{14}/run"},
        {"methods": ["GET"], "path": "/v1/runs/[a-f0-9]{14}"}
      ]
    }],
    "sockets": ["/run/ervisio-browser-robots/control.sock"]
  },
  "contributes": {
    "pages": [{"id": "robots", "title": "Browser Robots", "icon": "globe"}]
  },
  "visibleTo": {"groups": ["sudo", "wheel", "admin"]}
}
